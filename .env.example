# Server-only configuration. Never use VITE_ prefixes for credentials.
ARTAX_ORIGIN=https://your-artax-host.example
# Use an absolute file path outside the public document root and source checkout.
ARTAX_DB_PATH=/private/artax/artax.db
# JSON array of username, server-controlled role and scrypt salt:hash.
# Populate securely after generating hashes with server/hash-password.mjs.
ARTAX_USERS=[]
# Configure only in the server secret manager; keep out of builds and Actions.
OPENAI_API_KEY=
