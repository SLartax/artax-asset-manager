{
  "name": "artax-asset-manager",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run css",
    "dev": "vite",
    "prebuild": "npm run css",
    "build": "vite build",
    "postbuild": "node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "run": "bash run.sh",
    "deploy": "bash deploy.sh",
    "test": "node --test tests/*.test.mjs",
    "server": "node server/index.mjs",
    "typecheck": "tsc --noEmit",
    "css": "tailwindcss -i styles.css -o generated.css --minify"
  },
  "dependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.0",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "4.3.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
